<?xml version="1.0" encoding="utf-8"?>
<!--
  Exposes only the downloaded update APK to the system installer. Scoping the
  path this narrowly means the FileProvider cannot be used to read anything else
  in the app's storage.
-->
<paths>
    <files-path name="updates" path="updates/" />
    <cache-path name="update_cache" path="updates/" />
</paths>
