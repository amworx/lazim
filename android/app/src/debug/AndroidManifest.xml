<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Debug builds only: allow cleartext HTTP so the self-updater can be tested
      against a local manifest server (adb reverse tcp:8080 tcp:8080). Release
      builds keep Android's default cleartext block, so a shipped build can only
      fetch updates over HTTPS.
    -->
    <application android:usesCleartextTraffic="true" />
</manifest>
